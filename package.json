{
  "name": "claude-code-control-panel",
  "version": "1.0.0",
  "description": "Self-hosted web control panel for Claude Code CLI sessions",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && node --env-file=.env node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint src tests --ext .ts,.tsx",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env node_modules/vitest/vitest.mjs",
    "verify:image": "bash scripts/verify-image.sh",
    "smoke:container": "bash scripts/container-smoke.sh",
    "preflight": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/server/cli/preflight.ts",
    "backup": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/server/cli/backup.ts",
    "restore": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/server/cli/restore.ts",
    "telegram:set": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/server/cli/telegram-set.ts",
    "telegram:test": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/server/cli/telegram-test.ts",
    "telegram:discover": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/server/cli/telegram-discover.ts",
    "acceptance": "bash scripts/acceptance.sh",
    "build:client": "vite build",
    "dev:client": "vite build --watch"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^10.0.1",
    "argon2": "^0.41.0",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "otplib": "^13.5.0",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "^7.29.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.11",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
