{
  "name": "claude-code-control-panel",
  "version": "1.0.0",
  "description": "Self-hosted web control panel for Claude Code CLI sessions",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "build": "tsc && vite build",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^10.0.1",
    "argon2": "^0.41.0",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.4",
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "supertest": "^6.3.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.11",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
