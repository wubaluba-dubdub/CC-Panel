# Claude Code Control Panel — environment variables
# Copy to .env and fill in. NEVER commit a filled-in .env.

# REQUIRED — 32 random bytes, base64-encoded. Used to derive encryption subkeys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PANEL_MASTER_KEY=

# REQUIRED — username for the single admin user, seeded on first boot only.
PANEL_ADMIN_USERNAME=

# REQUIRED — password for the single admin user, seeded on first boot only.
# Must be at least 12 characters and not a known-weak password.
PANEL_ADMIN_PASSWORD=

# OPTIONAL — secret URL prefix. If unset, a random 22-char path is generated on
# first boot, persisted to /data/config/instance.json, and printed once at startup.
PANEL_BASE_PATH=

# OPTIONAL — trust X-Forwarded-For for client IP. Defaults to true on Railway.
PANEL_TRUST_PROXY=

# OPTIONAL — data directory path. Defaults to /data. For local development use
# a relative path like ./.localdata to keep state out of the repo.
PANEL_DATA_DIR=

# OPTIONAL — port to listen on. Railway injects this automatically.
PORT=
