{
  // The shipped build: the server half. `vite build` is the other half (vite.config.ts),
  // and `npm run build` runs both.
  //
  // Separate from tsconfig.json for two reasons. The base config includes
  // `tests/**` and sets `rootDir: "."`, so `tsc` emitted `dist/src/server/…` and
  // `dist/tests/…` — while the Dockerfile's `CMD` is `node dist/server/index.js`,
  // a path that never existed. And the shipped image has no business carrying the
  // test suite. Type-checking still covers tests: `npm run typecheck` uses the
  // base config.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  // `src/client` is Vite's, not tsc's. Left in, it would emit `dist/client/*.js` beside
  // the real Vite output and the server would serve whichever it found first.
  "exclude": ["node_modules", "dist", "tests", "src/client"]
}
